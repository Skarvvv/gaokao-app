# ============================================
# Dockerfile.hf — 适配 Hugging Face Spaces
# ============================================
# HF Spaces 特点：
#   - 免费版：2 vCPU, 16GB RAM（远超 Render 免费版）
#   - 默认端口 7860
#   - 48 小时无访问后自动休眠
#   - 不支持持久化磁盘（免费版）
#
# 使用方法：
#   1. 将此文件重命名为 Dockerfile（放在 HF Space 仓库根目录）
#   2. 在仓库根目录创建 README.md，内容：
#      ---
#      title: Gaokao Zhiyuan App
#      emoji: 🎓
#      colorFrom: blue
#      colorTo: green
#      sdk: docker
#      app_port: 7860
#      pinned: false
#      ---
#   3. 在 Space Settings > Repository secrets 中设置环境变量

FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir pymysql

COPY backend/ .
COPY css/ /app/frontend/css/
COPY js/ /app/frontend/js/
COPY data/ /app/frontend/data/
COPY index.html /app/frontend/index.html

ENV FRONTEND_DIR=/app/frontend
ENV GAOKAO_DEV_MODE=true
ENV SERVER_HOST=0.0.0.0
ENV SERVER_PORT=7860

RUN mkdir -p /app/logs

# HF Spaces 要求用 user uid=1000
RUN groupadd -r appuser && useradd -r -g appuser -u 1000 appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 7860

# 单 worker 即可（16GB 内存充足，但单 worker 对 SQLite 更安全）
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "7860", "--workers", "1", "--log-level", "info"]
