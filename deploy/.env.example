# ============================================
# 高考志愿填报 App — 生产环境配置模板
# ============================================
# 复制此文件为 .env 并填入真实值:
#   cp .env.example .env
#
# ⚠️  .env 文件包含敏感信息，绝不能提交到 Git！
# ============================================

# ── LLM API ──
# SiliconFlow (免费 Qwen2.5-7B)
LLM_API_KEY=your-siliconflow-api-key-here
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# 如需切换 DeepSeek (更强的中文能力):
# LLM_API_KEY=your-deepseek-api-key
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ── JWT Auth ──
# 必须设置一个强随机字符串！可用: openssl rand -hex 32
JWT_SECRET=your-strong-random-secret-here
JWT_EXPIRE_DAYS=7

# ── Database ──
# MVP 阶段可用 SQLite (留空即可，自动使用本地文件)
# 生产环境建议 MySQL:
# DATABASE_URL=mysql+pymysql://gaokao:your-password@localhost:3306/gaokao_app
DATABASE_URL=

# ── Server ──
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4

# ── Dev mode ──
# 设为 true 时允许缺失 env vars（自动用开发默认值）
# 生产环境务必设为空或 false
GAOKAO_DEV_MODE=
